 namespace {
-std::unordered_map<EndpointId, LazyRegisteredServerCluster<BooleanStateCluster>> gServers;
+
+// Extends BooleanStateCluster to support internal writes from attribute::update().
+// DefaultServerCluster::WriteAttribute returns UnsupportedWrite by default, which
+// blocks the set_val_via_write_attribute path used for ATTRIBUTE_FLAG_MANAGED_INTERNALLY.
+class ESPMatterBooleanStateCluster : public BooleanStateCluster
+{
+public:
+    using BooleanStateCluster::BooleanStateCluster;
+
+    ActionReturnStatus WriteAttribute(const WriteAttributeRequest & request,
+                                      AttributeValueDecoder & decoder) override
+    {
+        // Only allow internal writes (from attribute::update / set_val_via_write_attribute).
+        // External OTA writes are rejected per Matter spec (StateValue is read-only for clients).
+        if (request.path.mAttributeId == BooleanState::Attributes::StateValue::Id &&
+            request.operationFlags.Has(OperationFlags::kInternal))
+        {
+            bool newValue;
+            ReturnErrorOnFailure(decoder.Decode(newValue));
+            SetStateValue(newValue);
+            return Status::Success;
+        }
+        return DefaultServerCluster::WriteAttribute(request, decoder);
+    }
+};
+
+std::unordered_map<EndpointId, LazyRegisteredServerCluster<ESPMatterBooleanStateCluster>> gServers;
 
 } // namespace
 
